name: Deploy to Dev Server (Legacy / Disabled Archive)

# 主流水线已切到 build-and-deploy.yml。此文件仅作可逆历史存档；.disabled 后缀
# 不会被 GitHub 识别为 workflow，也不得作为绕过发布边界的手动入口。
on:
  workflow_dispatch:

jobs:
  deploy:
    runs-on: [self-hosted, Linux, X64]
    steps:
      - name: Checkout code
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false

      - name: Record start time
        run: echo "BUILD_START=$(date +%s)" >> "$GITHUB_ENV"

      - name: Deploy
        run: |
          cd ~/project/ai-audio-assistant-ui
          git pull
          docker compose up -d --build
          docker image prune -f
          docker builder prune --filter "until=72h" -f

      - name: Push deploy metrics
        if: always()
        run: bash ~/scripts/push-deploy-metrics.sh ai-audio-assistant-ui master ${{ job.status }} ${{ env.BUILD_START }}
